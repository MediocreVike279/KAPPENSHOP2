            }

            const isBlack = cap.crownColor.toLowerCase().includes('negro');
            const isOlive = cap.crownColor.toLowerCase().includes('olivo');
            
            let crownFill = "#E8DFD1"; // Cream/Beige default
            if (isBlack) crownFill = "#121318";
            if (isOlive) crownFill = "#3F4A2C";

            const patchAccent = isBlack ? "#FACC15" : "#10B981";

            return `
            <svg viewBox="0 0 200 150" class="w-full h-full max-h-44 drop-shadow-xl">
                <!-- Cap Crown -->
                <path d="M 35,95 C 35,32 165,32 165,95 Z" fill="${crownFill}" stroke="#282D3C" stroke-width="2"/>
                <!-- Button -->
                <circle cx="100" cy="33" r="4.5" fill="#000" />
                <!-- Seam lines -->
                <path d="M 100,33 L 100,95" stroke="rgba(0,0,0,0.15)" stroke-dasharray="2 2" stroke-width="1.5" />
                <path d="M 100,33 L 55,95" stroke="rgba(0,0,0,0.12)" stroke-dasharray="2 2" stroke-width="1" />
                <path d="M 100,33 L 145,95" stroke="rgba(0,0,0,0.12)" stroke-dasharray="2 2" stroke-width="1" />
                
                <!-- Black Visor -->
                <path d="M 22,94 C 40,118 160,118 178,94 C 188,114 12,114 22,94 Z" fill="#0A0B0E" stroke="#000" stroke-width="2"/>
                
                <!-- Gold Authenticity Sticker -->
                <ellipse cx="138" cy="102" rx="12" ry="6" fill="#FACC15" opacity="0.9" />
                <text x="138" y="104" font-size="4" font-weight="bold" fill="#000" text-anchor="middle">KAPPENSHOP</text>

                <!-- Front Patch Emblem 3D -->
                <g transform="translate(100, 68)">
                    <rect x="-20" y="-18" width="40" height="34" rx="6" fill="#08090C" stroke="${patchAccent}" stroke-width="1.5"/>
                    <foreignObject x="-14" y="-12" width="28" height="24">
                        <div xmlns="http://www.w3.org/1999/xhtml" class="w-full h-full flex flex-col items-center justify-center text-brand-gold text-xs">
                            <i class="fa-solid ${cap.icon}"></i>
                        </div>
                    </foreignObject>
                </g>
            </svg>
            `;
        }

        // Render product grid
        function renderProducts() {
            const grid = document.getElementById('products-grid');
            const noResults = document.getElementById('no-results');
            grid.innerHTML = '';

            const filtered = capsData.filter(cap => {
                const matchesSearch = cap.name.toLowerCase().includes(currentFilters.search) || 
                                      cap.styleCategory.toLowerCase().includes(currentFilters.search) ||
                                      cap.patchDesc.toLowerCase().includes(currentFilters.search);
                
                const matchesStyle = currentFilters.style === 'all' || cap.styleCategory === currentFilters.style;
                const matchesColor = currentFilters.color === 'all' || cap.colorCategory === currentFilters.color;

                return matchesSearch && matchesStyle && matchesColor;
            });

            if (filtered.length === 0) {
                noResults.classList.remove('hidden');
                return;
            } else {
                noResults.classList.add('hidden');
            }

            filtered.forEach(cap => {
                const card = document.createElement('div');
                card.className = "bg-darkCard border border-darkBorder rounded-2xl overflow-hidden shadow-xl hover:border-brand-gold/50 transition-all duration-300 flex flex-col group cap-card-glow";
                
                card.innerHTML = `
                    <!-- Cap Image Header -->
                    <div class="relative bg-gradient-to-b from-darkBg to-darkCard p-5 flex items-center justify-center border-b border-darkBorder/60 min-h-[200px]">
                        <span class="absolute top-3 left-3 bg-darkBg/90 border border-darkBorder px-2.5 py-1 rounded-md text-[10px] font-black text-brand-gold uppercase tracking-wider">
                            Kappenshop
                        </span>
                        
                        <div class="w-full flex justify-center group-hover:scale-105 transition-transform duration-300">
                            ${renderCapVisual(cap)}
                        </div>

                        <button onclick="openModal(${cap.id})" class="absolute bottom-3 right-3 bg-brand-gold text-slate-950 w-8 h-8 rounded-xl flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 shadow-lg">
                            <i class="fa-solid fa-eye text-xs"></i>
                        </button>
                    </div>

                    <!-- Card Body -->
                    <div class="p-4 flex flex-col flex-grow justify-between space-y-3">
                        <div>
                            <div class="flex justify-between items-start gap-2 mb-1">
                                <h3 class="font-display font-bold text-base text-white group-hover:text-brand-gold transition-colors">
                                    ${cap.name}
                                </h3>
                                <span class="text-xs font-black text-brand-gold bg-brand-gold/10 px-2 py-0.5 rounded border border-brand-gold/20 whitespace-nowrap">
                                    $${cap.price}
                                </span>
                            </div>
                            <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed">
                                ${cap.patchDesc}
                            </p>
                        </div>

                        <div class="flex flex-wrap gap-1.5 text-[10px]">
                            <span class="bg-darkBg text-slate-300 px-2 py-0.5 rounded border border-darkBorder">
                                <i class="fa-solid fa-palette text-brand-gold mr-1"></i>${cap.crownColor}
                            </span>
                            <span class="bg-darkBg text-slate-300 px-2 py-0.5 rounded border border-darkBorder">
                                <i class="fa-solid fa-tag text-brand-gold mr-1"></i>${cap.styleCategory}
                            </span>
                        </div>

                        <div class="flex gap-2 pt-2 border-t border-darkBorder/60">
                            <button onclick="openModal(${cap.id})" class="flex-1 bg-darkBg hover:bg-darkBorder text-slate-200 font-semibold py-2 px-2.5 rounded-xl text-xs transition-colors border border-darkBorder">
                                Detalle
                            </button>
                            <button onclick="addToCart(${cap.id})" class="flex-1 bg-brand-gold hover:bg-yellow-400 text-slate-950 font-bold py-2 px-2.5 rounded-xl text-xs transition-all flex items-center justify-center gap-1 shadow-md">
                                <i class="fa-solid fa-plus text-[10px]"></i> Cotizar
                            </button>
                        </div>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // Filter handlers
        function setThemeFilter(style) {
            currentFilters.style = style;
            document.querySelectorAll('.theme-btn').forEach(btn => {
                if (btn.innerText.trim().toLowerCase().includes(style.toLowerCase()) || (style === 'all' && btn.innerText.trim() === 'Todos')) {
                    btn.className = "theme-btn active px-3.5 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-all bg-brand-gold text-slate-950";
                } else {
                    btn.className = "theme-btn px-3.5 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-all bg-darkBg border border-darkBorder text-slate-300 hover:border-brand-gold";
                }
            });
            renderProducts();
        }

        function applyFilters() {
            currentFilters.color = document.getElementById('color-filter').value;
            renderProducts();
        }

        function resetFilters() {
            currentFilters = { search: '', style: 'all', color: 'all' };
            document.getElementById('search-input').value = '';
            document.getElementById('color-filter').value = 'all';
            setThemeFilter('all');
        }

        // Modal Logic
        function openModal(id) {
            const cap = capsData.find(item => item.id === id);
            if (!cap) return;

            activeModalCapId = id;

            document.getElementById('modal-title').innerText = cap.name;
            document.getElementById('modal-code').innerText = cap.code;
            document.getElementById('modal-desc').innerText = cap.patchDesc;
            document.getElementById('modal-price').innerText = `$${cap.price} MXN`;
            document.getElementById('modal-crown-color').innerText = cap.crownColor;
            document.getElementById('modal-visor-color').innerText = cap.visorColor;
            document.getElementById('custom-image-input').value = cap.customImage || '';

            document.getElementById('modal-img-container').innerHTML = renderCapVisual(cap);

            document.getElementById('modal-add-btn').onclick = () => {
                addToCart(cap.id);
                closeModal();
            };

            const waText = encodeURIComponent(`Hola Kappenshop, me interesa información sobre el modelo *${cap.name}* (${cap.code}) de $${cap.price} MXN.`);
            document.getElementById('modal-wa-btn').href = `https://wa.me/?text=${waText}`;

            document.getElementById('detail-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('detail-modal').classList.add('hidden');
            activeModalCapId = null;
        }

        function saveCustomImage() {
            if (!activeModalCapId) return;
            const url = document.getElementById('custom-image-input').value.trim();
            const cap = capsData.find(item => item.id === activeModalCapId);
            
            if (cap) {
                cap.customImage = url === '' ? null : url;
                document.getElementById('modal-img-container').innerHTML = renderCapVisual(cap);
                renderProducts();
            }
        }

        // Shopping Cart / Inquiry List Logic
        function addToCart(id) {
            const cap = capsData.find(item => item.id === id);
            const existing = cart.find(item => item.id === id);

            if (existing) {
                existing.quantity += 1;
            } else {
                cart.push({ ...cap, quantity: 1 });
            }

            updateCartUI();
            
            const badge = document.getElementById('cart-badge');
            badge.classList.add('scale-125');
            setTimeout(() => badge.classList.remove('scale-125'), 200);
        }

        function removeFromCart(id) {
            cart = cart.filter(item => item.id !== id);
            updateCartUI();
        }

        function changeQty(id, delta) {
            const item = cart.find(i => i.id === id);
            if (item) {
                item.quantity += delta;
                if (item.quantity <= 0) {
                    removeFromCart(id);
                } else {
                    updateCartUI();
                }
            }
        }

        function clearCart() {
            cart = [];
            updateCartUI();
        }

        function updateCartUI() {
            const cartItems = document.getElementById('cart-items');
            const cartBadge = document.getElementById('cart-badge');
            const cartTotal = document.getElementById('cart-total');

            const totalCount = cart.reduce((sum, item) => sum + item.quantity, 0);
            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);

            cartBadge.innerText = totalCount;
            cartTotal.innerText = `$${totalPrice} MXN`;

            if (cart.length === 0) {
                cartItems.innerHTML = `
                    <div class="text-center py-12 text-slate-500 space-y-2">
                        <i class="fa-solid fa-basket-shopping text-3xl"></i>
                        <p class="text-xs">Tu lista de pedido está vacía.</p>
                    </div>
                `;
                return;
            }

            cartItems.innerHTML = cart.map(item => `
                <div class="bg-darkBg p-3 rounded-xl border border-darkBorder flex items-center justify-between gap-3 text-xs">
                    <div class="flex-1">
                        <h4 class="font-bold text-white">${item.name}</h4>
                        <p class="text-[10px] text-slate-400">Kappenshop - $${item.price} c/u</p>
                    </div>
                    <div class="flex items-center gap-2 bg-darkCard border border-darkBorder rounded-lg p-1">
                        <button onclick="changeQty(${item.id}, -1)" class="w-5 h-5 flex items-center justify-center text-slate-400 hover:text-white">-</button>
                        <span class="font-bold text-brand-gold text-xs px-1">${item.quantity}</span>
                        <button onclick="changeQty(${item.id}, 1)" class="w-5 h-5 flex items-center justify-center text-slate-400 hover:text-white">+</button>
                    </div>
                    <button onclick="removeFromCart(${item.id})" class="text-slate-500 hover:text-rose-400 px-1">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </div>
            `).join('');
        }

        function toggleCartModal() {
            document.getElementById('cart-modal').classList.toggle('hidden');
        }

        function sendWhatsAppOrder() {
            if (cart.length === 0) {
                alert('Añade al menos una gorra a tu cotización.');
                return;
            }

            let message = "Hola *Kappenshop*, me gustaría solicitar la cotización del siguiente pedido:\n\n";
            let total = 0;

            cart.forEach((item, index) => {
                const subtotal = item.price * item.quantity;
                total += subtotal;
                message += `${index + 1}. *${item.name}*\n`;
                message += `   - Cantidad: ${item.quantity}\n`;
                message += `   - Código: ${item.code}\n`;
                message += `   - Subtotal: $${subtotal} MXN\n\n`;
            });

            message += `*Total estimado: $${total} MXN*\n\n`;
            message += "¿Me apoyan con la disponibilidad y datos para realizar la compra?";

            const waUrl = `https://wa.me/?text=${encodeURIComponent(message)}`;
            window.open(waUrl, '_blank');
        }
    </script>
</body>
</html>